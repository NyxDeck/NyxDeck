            (t("一键安装（全套链路）", "One-shot setup (whole pipeline)"), lambda: cmd_setup([]), False),
            (t("检查更新并重新部署", "Update and redeploy"), lambda: cmd_update([]), False),
            (t("体检", "Doctor"), lambda: cmd_doctor([]), False),
            (t("安装核心软件包", "Install core packages"), lambda: cmd_deps([]), False),
            (t("快照 / 回滚", "Snapshots / rollback"), backup_menu, True),
            (t("Mihomo TUN", "Mihomo TUN"), mihomo_menu, True),
            (vis, lambda: cmd_visualizer(["off"] if visualizer_enabled() else ["on"]), False),
            (t("插件（按分类）", "Plugins (by category)"), lambda: cmd_plugin(["list"]), False),
            (t("终端面板", "Terminal panel"), show_fetch, False),
            (t("标语 / Tagline", "Tagline"), tagline_menu, True),
            (t("Logo", "Logo"), logo_menu, True),
            (t("shell 层", "Shell layer"), shell_menu, True),
            (t("速查表（nyxhelp）", "Cheatsheet (nyxhelp)"), show_help, False),
            (t("语言 / Language", "Language"), select_language, True),
            (t("退出", "Exit"), None, True),
        ]
        choice = _menu(t("控制面板", "Control panel"), [label for label, _, _ in entries])
        if choice is None or entries[choice][1] is None:
            return 0
        clear_screen()
        _, action, stays = entries[choice]
        action()
        if not stays:
            _press_any_key()


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="nyxdeck",
        description=t("部署与管理 NyxDeck 桌面。", "Deploy and manage the NyxDeck desktop."),
    )
    sub = p.add_subparsers(dest="command")

    sub.add_parser("install", help=t("部署配置（调用 install.sh）", "deploy the configuration (runs install.sh)"))
    sub.add_parser("status", help=t("部署是否已同步", "is the deployment up to date?"))
    sub.add_parser("uninstall", help=t("移除部署的文件（机器状态保留）", "remove deployed files (machine state is kept)"))
    sub.add_parser("doctor", help=t("检查依赖、会话与插件", "check dependencies, the session, and plugins"))
    sub.add_parser("deps", help=t("安装核心软件包（pacman）；--check 只列出缺失",
                                 "install the core packages (pacman); --check lists what is missing"))
    sub.add_parser("plugin", help=t("管理 DMS 插件（按分类展示）：list | install <id> [--force] | enable <id> | disable <id> | update [id]",
                                    "manage DMS plugins (grouped by category): list | install <id> [--force] | enable <id> | disable <id> | update [id]"))
    sub.add_parser("mihomo", help=t("Mihomo TUN 链路：status | install | dashboard | plugin | secret | on | off | uninstall",
                                    "Mihomo TUN pipeline: status | install | dashboard | plugin | secret | on | off | uninstall"))
    sub.add_parser("setup", help=t("一键安装全套链路：依赖 → 配置 → 插件 → Mihomo（--dry-run/--no-mihomo/--no-plugins/--no-deps）",
                                    "one-shot setup: deps → configuration → plugins → Mihomo (--dry-run/--no-mihomo/--no-plugins/--no-deps)"))
    sub.add_parser("update", help=t("从 git 更新并重新部署（含声明的插件）",
                                    "update from git and redeploy (including declared plugins)"))
    sub.add_parser("backup", help=t("快照与回滚：list | create [备注] | restore [序号|名称]",
                                    "snapshots and rollback: list | create [note] | restore [index|name]"))
    sub.add_parser("shell", help=t("shell 层：status | doctor | install | edit",
                                   "shell layer: status | doctor | install | edit"))
    sub.add_parser("clean", help=t("缓存清理（clean-cache.py）", "cache cleaner (clean-cache.py)"))
    sub.add_parser("help", help=t("速查表：命令 + 桌面快捷键 + shell 助手",
                                  "cheatsheet: commands, keybindings, shell helpers"))
    sub.add_parser("logo", help=t("面板 Logo：pick（实时预览/可过滤）| show | list [过滤] | preview [名字] | set <名字|文件> | --reset",
                                  "panel logo: pick (live preview, filter) | show | list [filter] | preview [name] | set <name|file> | --reset"))
    sub.add_parser("tagline", help=t("NYX DECK 标语：pick（实时预览）| <文本> | --reset | --blank | show",
                                     "NYX DECK tagline: pick (live preview) | <text> | --reset | --blank | show"))
    sub.add_parser("fetch", help=t("终端欢迎面板（配色跟随壁纸）：[--compact|--native|--install]",
                                   "terminal welcome panel (colours follow the wallpaper): [--compact|--native|--install]"))
    sub.add_parser("visualizer", help=t("NyxRings 桌面组件：on | off | status",
                                        "NyxRings desktop widget: on | off | status"))
    sub.add_parser("widget", help=t("桌面组件：list", "desktop widgets: list"))
    sub.add_parser("lang", help=t("查看或设置语言：lang [zh|en]", "show or set the language: lang [zh|en]"))
    return p


def main(argv: list[str]) -> int:
    if argv and argv[0] in ("-h", "--help"):
        build_parser().print_help()
        return 0

    if not argv:
        # Interactive control panel; first run asks for the language.
        if not sys.stdin.isatty():
            build_parser().print_help()
            return 0
        if not _saved_lang():
            select_language()
        return main_menu()

    command, rest = argv[0], argv[1:]
    if command in ("install", "status", "uninstall"):
        return cmd_deploy([command, *rest])
    if command == "doctor":
        return cmd_doctor(rest)
    if command == "deps":
        return cmd_deps(rest)
    if command == "plugin":
        return cmd_plugin(rest)
    if command == "mihomo":
        return cmd_mihomo(rest)
    if command == "setup":
        return cmd_setup(rest)
    if command == "update":
        return cmd_update(rest)
    if command == "backup":
        return cmd_backup(rest)
    if command in ("help", "cheatsheet"):
        return cmd_help(rest)
    if command == "shell":
        return cmd_shell(rest)
    if command == "clean":
        return cmd_clean(rest)
    if command == "logo":
        return cmd_logo(rest)
    if command == "tagline":
        return cmd_tagline(rest)
    if command == "fetch":
        return cmd_fetch(rest)
    if command == "visualizer":
        return cmd_visualizer(rest)
    if command == "widget":
        return cmd_widget(rest)
    if command == "lang":
        return cmd_lang(rest)

    err(t(f"未知命令: {command}", f"unknown command: {command}"))
    build_parser().print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
