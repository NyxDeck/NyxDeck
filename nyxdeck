def _fzf(args: list[str], lines: list[str]) -> subprocess.CompletedProcess:
    """Run fzf with the list on stdin; its UI draws on the tty itself, so the
    captured stdout is just the choice."""
    return subprocess.run(["fzf", *args], input="\n".join(lines) + "\n",
                          text=True, capture_output=True, check=False)


def _pick_cmd(script: Path, *extra: str) -> str:
    return " ".join(shlex.quote(part) for part in
                    (sys.executable or "python3", str(script), *extra))


def _fetch_script() -> Path | None:
    for candidate in (FETCH_SCRIPT, CONFIG_HOME / "fastfetch" / "fetch.py"):
        if candidate.is_file():
            return candidate
    return None


def _fetch_py(*args: str) -> int:
    script = _fetch_script()
    if not script:
        err(t("找不到 fetch.py（先 nyxdeck install）", "fetch.py not found (run nyxdeck install)"))
        return 1
    return subprocess.run([sys.executable or "python3", str(script), *args]).returncode


def _logo_names() -> set[str]:
    script = _fetch_script()
    if not script:
        return set()
    res = subprocess.run([sys.executable or "python3", str(script), "--logo-list", ""],
                         capture_output=True, text=True, check=False)
    # the last line is the "N logos" count
    return {token for line in res.stdout.splitlines()[:-1] for token in line.split()}


def current_logo() -> str:
