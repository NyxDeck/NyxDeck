#!/usr/bin/env python3
"""nyxdeck — command line for the NyxDeck desktop.

Deploys the configuration, installs dependencies and DMS plugins (including
NyxRings), and toggles desktop features. Bilingual (zh/en), selected from the
locale, overridable with NYXDECK_LANG. Standard library only.
"""

from __future__ import annotations

import argparse
import json
import os
import select
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(os.path.realpath(__file__)).parent
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
DMS_DIR = CONFIG_HOME / "DankMaterialShell"
PLUGIN_DIR = DMS_DIR / "plugins"
SETTINGS = DMS_DIR / "settings.json"
NIRI_CONFIG = CONFIG_HOME / "niri" / "config.kdl"
LANG_FILE = CONFIG_HOME / "nyxdeck" / "lang"

VERSION = "0.1.0"

# Packages NyxDeck needs at runtime.
CORE_DEPS = ["cava", "matugen", "qt6ct", "wtype"]

# Plugins installed by cloning a repository. Other ids go through
# `dms plugins install` (the registry).
PLUGIN_REPOS = {
    "nyxRings": "https://github.com/NyxDeck/nyxRings.git",
}

VISUALIZER_PLUGIN = "nyxRings"

BANNER = r"""
