        say(t("可选：nyxdeck logo pick / list / preview / set <名字|文件> / --reset",
              "use: nyxdeck logo pick / list / preview / set <name|file> / --reset"))
        return 0

    if action in ("pick", "select"):
        return pick_logo()

    if action == "list":
        return _fetch_py("--logo-list", argv[1] if len(argv) > 1 else "")

    if action == "preview":
        return _fetch_py("--logo-preview", argv[1] if len(argv) > 1 else current_logo())

    if action in ("--reset", "reset", "default"):
        LOGO_FILE.unlink(missing_ok=True)
        ok(t("Logo 已恢复系统默认（按发行版自动识别）",
             "logo reset to the system default (auto-detected)"))
        return 0

    if action == "set":
        argv = argv[1:]
    value = " ".join(argv).strip()
    if not value:
        err(t("用法: nyxdeck logo [show|pick|list [过滤]|preview [名字]|set <名字|文件>|--reset]",
              "usage: nyxdeck logo [show|pick|list [filter]|preview [name]|set <name|file>|--reset]"))
        return 2

    if value != "default" and not Path(value).expanduser().is_file():
        names = _logo_names()
        if names and value not in names:
            near = [n for n in sorted(names) if value.lower() in n.lower()][:6]
            err(t(f"没有这个内置 logo：{value}" +
                  (t(f"（相近：{', '.join(near)}）", f" (similar: {', '.join(near)})") if near else ""),
                  f"no built-in logo named {value}" +
                  (f" (similar: {', '.join(near)})" if near else "")))
            return 1

    LOGO_FILE.parent.mkdir(parents=True, exist_ok=True)
    LOGO_FILE.write_text(value + "\n", encoding="utf-8")
    ok(t(f"Logo 已设为：{logo_description(value)}", f"logo set to: {logo_description(value)}"))
    return 0


def pick_logo() -> int:
    """Choices, current value, live preview and filtering in one screen."""
    script = _fetch_script()
    if not script:
        err(t("找不到 fetch.py（先 nyxdeck install）", "fetch.py not found (run nyxdeck install)"))
        return 1
    if not have("fzf"):
        warn(t("没装 fzf，退回逐项菜单", "fzf is missing; falling back to the menu"))
        return logo_menu()

    names = sorted(_logo_names())
    if not names:
        err(t("fastfetch 没有给出 logo 列表", "fastfetch gave no logo list"))
        return 1
    current = current_logo() or "default"
    entries = ["default"] + [n for n in names if n != "default"]
    lines = [f"{'❯' if e == current else ' '}\t{e}" for e in entries]
    start = entries.index(current) + 1 if current in entries else 1

    header = t(
        f"当前 {current}   ·   输入即过滤   ·   Enter 应用   ·   Esc 取消",
        f"current {current}   ·   type to filter   ·   Enter applies   ·   Esc cancels")
    res = _fzf([
        "--height=100%", "--prompt=logo> ", "--pointer=› ",
        "--delimiter=\t", "--with-nth=2", "--no-multi", "--info=inline-right",
        "--header", header,
        "--preview", _pick_cmd(script, "--logo-preview") + " {2}",
        "--preview-window", "right:55%,noborder",
        "--bind", f"start:pos({start})",
    ], lines)
    if res.returncode != 0:
        say(t("已取消", "cancelled"))
        return 0
    chosen = res.stdout.strip().split("\t")[-1].strip()
    if not chosen:
        say(t("已取消", "cancelled"))
        return 0
    return cmd_logo(["--reset"] if chosen == "default" else ["set", chosen])


def pick_tagline() -> int:
    """Type a tagline and watch the header update; the list carries suggestions."""
    script = _fetch_script()
    if not script or not have("fzf"):
        answer = _prompt(t("新标语（留空取消）", "new tagline (empty cancels)"))
        return cmd_tagline([answer]) if answer else 0

    hidden = t("(隐藏标语)", "(hide the tagline)")
    suggestions = [
        default_tagline(),
        t("干净 · 可控 · 可预期", "clean, controllable, predictable"),
        t("自足的桌面环境", "a self-contained desktop environment"),
        hidden,
    ]
    header = t("输入自定义标语（实时预览）  ·  Enter 应用  ·  Esc 取消",
               "type a tagline (live preview)  ·  Enter applies  ·  Esc cancels")
    res = _fzf([
        "--height=20%", "--print-query", "--prompt=tagline> ", "--pointer=› ",
        "--no-multi", "--info=inline-right", "--header", header,
        "--preview", _pick_cmd(script, "--header-preview") + " {q}",
        "--preview-window", "up:3,noborder",
    ], suggestions)
    if not res.stdout.strip():
        say(t("已取消", "cancelled"))
        return 0
    output = res.stdout.splitlines()
    typed = output[0].strip() if output else ""
    picked = output[1].strip() if len(output) > 1 else ""
    value = typed or picked
    if value == hidden:
        return cmd_tagline(["--blank"])
    if not value or value == default_tagline():
        return cmd_tagline(["--reset"])
    return cmd_tagline([value])


