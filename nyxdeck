def default_tagline() -> str:
    return t("自足的桌面", "a self-contained desktop")


def current_tagline() -> str:
    """Effective tagline: the file wins, otherwise the built-in default."""
    try:
        return TAGLINE_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        return default_tagline()


def set_tagline(value: str) -> None:
    TAGLINE_FILE.parent.mkdir(parents=True, exist_ok=True)
