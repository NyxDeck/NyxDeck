def _shell_state(relative: str) -> tuple[str, str]:
    """(state, detail) for a file this repository owns."""
    dst = CONFIG_HOME / relative
    src = REPO / "configs" / relative
    if not src.is_file():
        return "unknown", t("仓库里没有", "not in the repository")
    if not dst.exists():
        return "missing", t("未部署", "not deployed")
    if relative == "starship.toml":
        # Merged at deploy time, so compare meaning rather than bytes.
        text = dst.read_text(encoding="utf-8", errors="replace")
        ok = 'palette = "dms"' in text and "PALETTE >>>" in text
        return ("ok" if ok else "drift"), t("已部署（合并布局与调色板）",
                                            "deployed (layout merged with palette)")
    same = _same_content(src, dst)
    if same:
        return "ok", t("已部署，与仓库一致", "deployed and matches the repository")
    return "drift", t("已部署但被改动过", "deployed but modified")


def _same_content(src: Path, dst: Path) -> bool:
    try:
        a = src.read_text(encoding="utf-8").replace("/home/user", str(HOME))
        b = dst.read_text(encoding="utf-8")
    except OSError:
        return False
    return a == b


def cmd_shell(argv: list[str]) -> int:
    action = argv[0] if argv else "status"

    if action in ("status", "show"):
        say(t("shell 层", "shell layer"))
        for relative, label in SHELL_FILES:
            state, detail = _shell_state(relative)
            line = f"{relative}  —  {detail}"
            {"ok": ok, "drift": warn, "missing": warn}.get(state, warn)(line)
            say(f"      {label}")
        return 0

    if action == "doctor":
        say(t("shell 层体检", "shell layer check"))
        problems = 0
        for relative, _ in SHELL_FILES:
            state, detail = _shell_state(relative)
            if state == "ok":
                ok(f"{relative}")
            else:
                warn(f"{relative}  —  {detail}")
                problems += 1
        say("")
        if have("starship"):
            ok(t("starship 已安装", "starship installed"))
        else:
            warn(t("starship 未安装（提示符不会生效）", "starship is missing (no prompt)"))
            problems += 1
        cfg = SHELL_DIR / "config.fish"
        if cfg.is_file() and "_nyxdeck_pkg_helper" in cfg.read_text(encoding="utf-8", errors="replace"):
            ok(t("config.fish 是 NyxDeck 版本", "config.fish is the NyxDeck version"))
        else:
            warn(t("config.fish 还是旧版本（跑 nyxdeck shell install）",
                   "config.fish is not the NyxDeck version (run nyxdeck shell install)"))
            problems += 1
        if have("fish"):
            want, got, missing_plugins = _fisher_state()
            if want == 0:
                pass
            elif not missing_plugins:
                ok(t(f"fisher 插件 {got}/{want} 就位", f"fisher plugins {got}/{want}"))
            else:
                warn(t(f"fisher 插件缺：{', '.join(missing_plugins)}",
                       f"fisher plugins missing: {', '.join(missing_plugins)}"))
        say("")
        if problems == 0:
            ok(t("shell 层干净", "shell layer is clean"))
        return 0

    if action == "install":
        script = REPO / "install.sh"
        if not script.is_file():
            err(t("找不到 install.sh", "install.sh not found"))
            return 1
        return subprocess.run([str(script), "install"]).returncode

    if action == "edit":
