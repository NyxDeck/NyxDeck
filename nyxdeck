def _saved_lang() -> str:
    if LANG_FILE.is_file():
        value = LANG_FILE.read_text(encoding="utf-8").strip().lower()
        if value.startswith("zh"):
            return "zh"
        if value.startswith("en"):
            return "en"
    return ""


def _detect_lang() -> str:
    saved = _saved_lang()
    if saved:
        return saved
    override = os.environ.get("NYXDECK_LANG", "").strip().lower()
    if override:
        return "zh" if override.startswith("zh") else "en"
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var, "").lower()
        if value:
            return "zh" if value.startswith("zh") else "en"
    return "en"


LANG = _detect_lang()


def set_lang(lang: str) -> None:
    global LANG
    LANG = "zh" if lang.startswith("zh") else "en"
    LANG_FILE.parent.mkdir(parents=True, exist_ok=True)
    LANG_FILE.write_text(LANG + "\n", encoding="utf-8")


def t(zh: str, en: str) -> str:
    """Pick a bilingual string by the active language."""
    return zh if LANG == "zh" else en


# ── Colors ──────────────────────────────────────────────────────────────────

R = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"


def _load_palette() -> dict:
    """DMS's generated Material You palette, refreshed on every theme change."""
    if os.environ.get("NO_COLOR"):
        return {}
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    try:
        data = json.loads((cache / "DankMaterialShell" / "dms-colors.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data.get("colors", {}).get(data.get("mode", "dark")) or {}


def _truecolor(value: str) -> str:
    hex_value = str(value or "").lstrip("#")
    if len(hex_value) != 6:
        return ""
    try:
        channels = tuple(int(hex_value[i:i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        return ""
    return "\033[38;2;%d;%d;%dm" % channels


PALETTE = _load_palette()


def _role(name: str, fallback: str) -> str:
    return _truecolor(PALETTE.get(name, "")) or fallback


# The CLI follows the desktop instead of a fixed ANSI green, so it agrees with
# the bar, the terminal and the wallpaper. Each slot keeps an ANSI fallback for
# the case where the palette cache does not exist yet.
ACCENT = _role("primary", "\033[36m")             # banner, titles, selection, success
WARN_COLOR = _role("tertiary", "\033[33m")        # warnings
ERR_COLOR = _role("error", "\033[31m")            # failures
TEXT = _role("on_surface", "\033[37m")            # plain emphasis
MUTED = _role("on_surface_variant", "\033[90m")   # secondary text, hints, idle items


def clear_screen() -> None:
