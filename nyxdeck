        editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "nano"
        if not sys.stdin.isatty():
            say(str(CUSTOM_FISH))
            return 0
        return subprocess.run([editor, str(CUSTOM_FISH)]).returncode

    err(t(f"未知的 shell 操作: {action}（status | doctor | install | edit）",
          f"unknown shell action: {action} (status | doctor | install | edit)"))
    return 2


