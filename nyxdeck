def cmd_setup(argv: list[str]) -> int:
    """One command for a fresh machine: dependencies, configuration, the
    declared plugins, and the mihomo chain."""
    dry = "--dry-run" in argv or "-n" in argv
    steps: list[tuple[str, object]] = []

    if "--no-deps" not in argv:
        steps.append((t("核心依赖（pacman/AUR）", "core dependencies (pacman/AUR)"),
                      lambda: cmd_deps([])))
    steps.append((t("部署配置", "deploy the configuration"),
                  lambda: cmd_deploy(["install"])))
    if "--no-plugins" not in argv:
        for plugin in PLUGIN_REPOS:
            steps.append((t(f"插件 {plugin}", f"plugin {plugin}"),
                          lambda plugin=plugin: _install_repo_plugin(plugin, PLUGIN_REPOS[plugin])))
    if "--no-mihomo" not in argv:
        steps.append((t("Mihomo TUN 链路（内核 → 配置 → 面板 → 服务 → 插件）",
                        "Mihomo TUN pipeline (core → config → dashboard → unit → plugin)"),
                      lambda: cmd_mihomo(["install"])))
    steps.append((t("重启 DMS", "restart DMS"), lambda: dms_restart() or 0))

    say(t("NyxDeck 一键安装", "NyxDeck one-shot setup"))
    if dry:
        for label, _ in steps:
            say(f"  · {label}")
        say("")
        say(t("（--dry-run，未执行）", "(--dry-run, nothing was done)"))
        return 0

    # Snapshot first, so a setup that goes wrong is one command away from undone.
    script = REPO / "install.sh"
    if script.is_file():
        subprocess.run([str(script), "snapshot", SETUP_STEPS_NOTE], check=False)

    failed = []
    for label, action in steps:
        say("")
        say(f"{ACCENT}:: {label}{R}")
        try:
            code = action()
        except Exception:
            code = 1
        if code not in (0, None):
            failed.append(label)

    say("")
    if failed:
        warn(t(f"{len(failed)} 步未成功：{'、'.join(failed)}",
               f"{len(failed)} step(s) did not succeed: {', '.join(failed)}"))
        say(t("（可用 nyxdeck backup restore 回到安装前）",
              "(nyxdeck backup restore undoes it)"))
        return 1
    ok(t("全套链路就绪", "the whole pipeline is ready"))
    return 0


def cmd_update(argv: list[str]) -> int:
    """Update from git, redeploy, refresh the declared plugins."""
    if not (REPO / ".git").is_dir():
        err(t(f"{REPO} 不是 git 检出，无法自动更新", f"{REPO} is not a git checkout"))
        return 1
    before = _capture(["git", "-C", str(REPO), "rev-parse", "--short", "HEAD"])
    if subprocess.run(["git", "-C", str(REPO), "pull", "--ff-only"]).returncode != 0:
        warn(t("git pull 失败（本地是否有未提交改动？）",
               "git pull failed (uncommitted changes?)"))
        return 1
    after = _capture(["git", "-C", str(REPO), "rev-parse", "--short", "HEAD"])
    say(t(f"仓库 {before} → {after}", f"repository {before} → {after}"))
    if before == after:
        say(t("已是最新。", "already up to date."))

    rc = cmd_deploy(["install"])
    if "--no-plugins" not in argv:
        for plugin in PLUGIN_REPOS:
            target = plugin_dir(plugin)
            if (target / ".git").is_dir():
                say(t(f"更新插件 {plugin}", f"updating plugin {plugin}"))
                subprocess.run(["git", "-C", str(target), "pull", "--ff-only"], check=False)
    dms_restart()
    ok(t("更新完成", "update complete"))
    return rc


