def _pkg_installed(package: str) -> bool:
    """Ask pacman; a command check would miss libraries, fonts and shells."""
    if not have("pacman"):
        return have(package)
    return subprocess.run(["pacman", "-Qq", package], capture_output=True, check=False).returncode == 0


def _pkg_source(package: str) -> str:
    """'repo' or 'aur' — the latter needs an AUR helper."""
    if not have("pacman"):
        return "unknown"
    probe = subprocess.run(["pacman", "-Si", package], capture_output=True, check=False)
    return "repo" if probe.returncode == 0 else "aur"


def _aur_helper() -> str:
    for helper in ("paru", "yay"):
        if have(helper):
            return helper
    return ""


# Plugin -> a function it installs. `fisher list` prints nothing outside a tty,
# so ask fish directly whether each plugin's marker function is there.
FISHER_MARKERS = {
    "jorgebucaran/fisher": "fisher",
    "jorgebucaran/autopair.fish": "_autopair_backspace",
    "PatrickF1/fzf.fish": "fzf_configure_bindings",
}


def _fisher_state() -> tuple[int, int, list[str]]:
    """(declared, present, missing plugin names)."""
    declared_file = CONFIG_HOME / "fish" / "fish_plugins"
    if not declared_file.is_file():
        return 0, 0, []
    declared = [line.strip() for line in declared_file.read_text().splitlines() if line.strip()]
    present, missing = 0, []
    for entry in declared:
        name = entry.split("@")[0]
        marker = FISHER_MARKERS.get(name)
        if not marker:
            present += 1          # unknown plugin: assume whoever declared it knows
            continue
        res = subprocess.run(["fish", "-c", f"functions -q {marker}"], capture_output=True, check=False)
        if res.returncode == 0:
            present += 1
        else:
            missing.append(name)
    return len(declared), present, missing


def _pick_packages(packages: list[str]) -> list[str] | None:
    """Multi-select over the missing packages, with the package info as preview."""
    if not packages:
        ok(t("依赖都已安装。", "All dependencies are installed."))
        return None
    if not have("fzf"):
        warn(t("没装 fzf，按全部处理", "fzf is missing; taking all of them"))
        return packages
    header = t(f"{len(packages)} 个待安装   ·   Tab 多选   ·   Enter 安装   ·   Esc 取消",
               f"{len(packages)} to install   ·   Tab to select   ·   Enter installs   ·   Esc cancels")
    res = _fzf([
        "--multi", "--height=100%", "--prompt=deps> ", "--pointer=› ",
        "--header", header, "--info=inline-right",
        "--preview", "pacman -Si {} 2>/dev/null || paru -Si {} 2>/dev/null || echo (AUR)",
        "--preview-window", "right:60%,noborder",
    ], packages)
    if res.returncode != 0 or not res.stdout.strip():
        say(t("已取消", "cancelled"))
        return []
    return [line.split()[-1] for line in res.stdout.splitlines() if line.strip()]


def cmd_deps(argv: list[str]) -> int:
    check_only = "--check" in argv
    pick = "--pick" in argv
    pool = list(CORE_DEPS)
    if "--optional" in argv or "--all" in argv:
        pool += OPTIONAL_DEPS

    missing = [p for p in pool if not _pkg_installed(p)]
    if pick:
        chosen = _pick_packages(missing)
        if chosen is None:
            return 0
        missing = chosen
    if not missing:
        say(t("核心依赖都已安装。", "All core dependencies are installed."))
        return 0
    if check_only:
        warn(t("缺少：", "missing: ") + ", ".join(missing))
        return 1
    if not have("pacman"):
        err(t("未找到 pacman；请手动安装：", "pacman not found; install manually: ") + " ".join(missing))
        return 1

    # Official repositories first, then whatever only exists in the AUR.
    repo = [p for p in missing if _pkg_source(p) == "repo"]
    aur = [p for p in missing if _pkg_source(p) == "aur"]
    status = 0
    if repo:
        say(t("安装官方仓库包：", "Installing from the repositories: ") + " ".join(repo))
        status |= subprocess.run(["sudo", "pacman", "-S", "--needed", *repo]).returncode
    if aur:
        helper = _aur_helper()
        if helper:
            say(t(f"安装 AUR 包（{helper}）：", f"Installing from the AUR ({helper}): ") + " ".join(aur))
            status |= subprocess.run([helper, "-S", "--needed", *aur]).returncode
        else:
            warn(t("这些包只在 AUR，需要一个 AUR helper（paru/yay）：",
                   "these only exist in the AUR and need an AUR helper (paru/yay): ") + " ".join(aur))
            status = 1
    return status


def _install_repo_plugin(plugin: str, url: str, force: bool = False) -> int:
    target = plugin_dir(plugin)
    state = plugin_state(plugin)

    if target.exists() and force:
        say(t(f"删除并重新克隆 {plugin}", f"Removing and re-cloning {plugin}"))
        shutil.rmtree(target)
        state = plugin_state(plugin)

    if target.is_dir():
        if not state["manifest_ok"]:
            warn(t(f"{plugin} 目录在，但 plugin.json 无效，可能装坏了（--force 可重装）",
                   f"{plugin} exists but plugin.json is invalid; reinstall with --force"))
        elif not state["git_repo"]:
            warn(t(f"{plugin} 已安装，但不是 git 仓库，无法用 git 更新（--force 可重装）",
                   f"{plugin} is installed but not a git checkout, so git cannot update it (use --force)"))
        else:
            ok(t(f"{plugin} 已安装（{target}）", f"{plugin} already installed ({target})"))
        if state["dms"] == "disabled":
            dms("ipc", "call", "plugins", "enable", plugin)
            dms_restart()
        return 0

    PLUGIN_DIR.mkdir(parents=True, exist_ok=True)
    say(t(f"正在克隆 {url}", f"Cloning {url}"))
    rc = subprocess.run(["git", "clone", "--depth", "1", url, str(target)]).returncode
    if rc != 0:
        err(t(f"{plugin} 克隆失败", f"failed to clone {plugin}"))
        return rc
    if not plugin_state(plugin)["manifest_ok"]:
        warn(t(f"{plugin} 已克隆，但 plugin.json 无效", f"{plugin} cloned but its plugin.json is invalid"))
    dms_restart()
    return 0


def cmd_plugin(argv: list[str]) -> int:
    action = argv[0] if argv else "list"
    rest = argv[1:]

    if action == "list":
        return print_plugin_report()

    if action in ("enable", "disable"):
        if not rest:
            err(t(f"用法: nyxdeck plugin {action} <id>", f"usage: nyxdeck plugin {action} <id>"))
            return 2
        plugin = rest[0]
        if not plugin_state(plugin)["dir"]:
            err(t(f"{plugin} 未安装", f"{plugin} is not installed"))
            return 1
        rc = dms("ipc", "call", "plugins", action, plugin).returncode
        dms_restart()
        if rc == 0:
            ok(t(f"{plugin} 已{'启用' if action == 'enable' else '停用'}",
                 f"{plugin} {'enabled' if action == 'enable' else 'disabled'}"))
        return rc

    if action == "install":
        args = [a for a in rest if not a.startswith("-")]
        force = "--force" in rest
        if not args:
            err(t("用法: nyxdeck plugin install <id> [--force]",
                  "usage: nyxdeck plugin install <id> [--force]"))
            return 2
        plugin = args[0]
        if plugin in PLUGIN_REPOS:
            return _install_repo_plugin(plugin, PLUGIN_REPOS[plugin], force)
        rc = dms("plugins", "install", plugin).returncode
        if rc == 0:
            dms("ipc", "call", "plugins", "enable", plugin)
            dms_restart()
        return rc

    if action == "update":
        targets = rest or [p for p in PLUGIN_REPOS if (PLUGIN_DIR / p).is_dir()]
        rc = 0
        for plugin in targets:
            target = plugin_dir(plugin)
            if not target.is_dir():
                warn(t(f"{plugin} 未安装", f"{plugin} not installed"))
                continue
            if not (target / ".git").is_dir():
                warn(t(f"{plugin} 不是 git 仓库，跳过", f"{plugin} is not a git checkout, skipping"))
                continue
            say(t(f"更新 {plugin}", f"Updating {plugin}"))
