def _prompt(question: str) -> str | None:
    if not sys.stdin.isatty():
        return None
    try:
        return input(f"{question}: ").strip()
    except (EOFError, KeyboardInterrupt):
        return None


def cmd_tagline(argv: list[str]) -> int:
