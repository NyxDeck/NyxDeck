def _niri_binds() -> list[tuple[str, str]]:
    """(binding, command) parsed from the niri configuration in use."""
    try:
        text = BINDS_FILE.read_text(encoding="utf-8")
    except OSError:
        return []
    pattern = re.compile(r"^\s*([A-Za-z0-9_]+(?:\+[A-Za-z0-9_]+)*)\s+(?:[a-z-]+=\S+\s+)*\{\s*(.+?)\s*\}\s*$")
    binds = []
    for line in text.splitlines():
        match = pattern.match(line)
        if not match:
            continue
        quoted = re.search(r'"([^"]+)"', match.group(2))
        binds.append((match.group(1), quoted.group(1) if quoted else match.group(2)))
    return binds


def _pad(text: str, width: int) -> str:
    """Pad to a cell width; CJK counts as two columns or the columns wobble."""
    cells = sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in text)
    return text + " " * max(1, width - cells)


