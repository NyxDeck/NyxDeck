// -----------------------------------------------------------------------------
// NyxDeck monitor configuration (monitor.kdl)
// -----------------------------------------------------------------------------
// Per-display settings: resolution, refresh rate, scale, and position.
//
// No entries are required. niri detects connected displays and drives them
// with recommended settings. Uncomment and adapt the examples below to tune a
// specific output.
// Reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs
// -----------------------------------------------------------------------------

// Example: built-in laptop panel (1080p @ 60 Hz)
// output "eDP-1" {
//     mode "1920x1080@60.000"
//     scale 1.0
//     position x=0 y=0
// }

// Example: external high-refresh display (1440p @ 144 Hz with VRR)
// output "DP-1" {
//     mode "2560x1440@144.000"
//     scale 1.0
//     position x=1920 y=0
//     variable-refresh-rate
// }
