// 引入由 nwg-displays 生成的显示器配置
include "monitor.kdl"
// 动态引入视觉特效样式 (普通模式 vs 护眼模式)
include "effects.kdl"
// 引入输入设备与手势配置 (受 Dunder Protocol 保护，更新自动保留)
include optional=true "input__custom__.kdl"
// 引入布局设置
include "layout.kdl"
// 引入 DMS 生成的 niri 配色（focus-ring / tab-indicator / shadow 跟随 DMS 主题）
include optional=true "dms/colors.kdl"
// 引入动画配置
include "animations.kdl"
// 引入窗口与图层规则
include "rules.kdl"
// 引入快捷键绑定配置
include "binds.kdl"

overview {
    backdrop-color "#4c566a90"
    workspace-shadow {
        off
    }
}

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"

    // NVIDIA env: deploy enables these only when NVIDIA is the display GPU
    // (not when it is only a 3D controller next to an AMD/Intel iGPU)
    // GBM_BACKEND "nvidia-drm"
    // __GLX_VENDOR_LIBRARY_NAME "nvidia"
    // LIBVA_DRIVER_NAME "nvidia"
}

spawn-at-startup "~/.config/DankMaterialShell/start.sh"
// niri does not consume /etc/xdg/autostart entries on its own.
spawn-at-startup "sh" "-c" "command -v fcitx5 >/dev/null 2>&1 && exec fcitx5 -d"
spawn-at-startup "~/.config/niri/scripts/toggle-eyecare.sh" "--sync"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
// @PICTURES@ is the XDG pictures directory, expanded by install.sh: the name
// is locale-dependent (~/Pictures, ~/图片, ~/Bilder, …) and niri cannot ask.
screenshot-path "@PICTURES@/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

debug {
    honor-xdg-activation-with-invalid-serial
    // 台式机的独显渲染节点已移除（本机为 Intel 核显 + NVIDIA 混合输出），
    // 交给 niri 自动选择渲染设备。
}

recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
    highlight {
        corner-radius 12
        active-color "#b6c7e7"
        urgent-color "#ffb4ab"
    }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

// ==========================================================
// 用户自定义配置 (User Custom Configuration)
// 将自定义的自启项或窗口规则写在 __custom__.kdl 中，更新时自动保留。
// 你也可以在当前目录创建 __custom__/ 文件夹放置个人脚本。
// ==========================================================
include "__custom__.kdl"

// ==========================================================
// DMS 自己管理的 include (included by the DankMaterialShell settings)
// DMS 会把显示器、窗口规则、输入、布局、快捷键、光标等设置写进 niri/dms/，
// 并在需要时自己往这个文件里补上下面几行。这里预先写出来，是为了让重新部署
// 不会把它们删掉、也让 DMS 一开箱就能找到。optional=true 保证 DMS 还没写入
// 文件时（全新机器）niri 配置依然有效。
// ==========================================================
include optional=true "dms/outputs.kdl"
include optional=true "dms/windowrules.kdl"
include optional=true "dms/input.kdl"
include optional=true "dms/layout.kdl"
include optional=true "dms/binds.kdl"
include optional=true "dms/cursor.kdl"
